# Prevent direct download of sensitive customer data and credentials
<FilesMatch "^(admin_credentials|orders|inquiries)\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
